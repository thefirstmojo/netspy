# NetSpy — example environment. Copy to .env and adjust.

# Role: web = dashboard + local sampler (Unraid)
#       agent = collector + API only (TrueNAS, via Portainer)
ROLE=web

# Servers the dashboard polls. Format: Name=local;Name=http://ip:port
#   local          = sample this host directly (web role)
#   http://ip:port = agent API of another host (e.g. TrueNAS)
# (Example IPs — use your own.)
SERVERS=Unraid=local;TrueNAS=http://10.10.10.20:8091

# Interfaces counted as "total traffic" (comma-separated).
# Auto-fallback if empty: br0 -> bond0 -> first eth*/en*
UPLINK=br0

# Ports
WEB_PORT=8090
AGENT_PORT=8091

# Optional: shared token between web and agent
# (web sends it as X-Agent-Token header to the TrueNAS agent)
AGENT_TOKEN=

# Image source. Default (empty) = ghcr.io/thefirstmojo/netspy:latest (public, pulled).
# Only set for a locally built image, e.g.:
#   docker build -t netspy:latest .   then   NETSPY_IMAGE=netspy:latest
# (GHCR versions are created by tag pushes, see .github/workflows/publish-image.yml)
NETSPY_IMAGE=

# Optional: container name
NETSPY_CONTAINER=netspy
