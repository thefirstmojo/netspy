# NetMon — Beispiel-Umgebung. Kopieren nach .env und anpassen.

# Rolle: web = Dashboard + lokaler Sampler (Unraid)
#        agent = nur Collector + API (TrueNAS, via Portainer)
ROLE=web

# Server, die das Dashboard pollt. Format: Name=local;Name=http://ip:port
#   local          = dieser Host wird direkt gesampelt (web-Rolle)
#   http://ip:port = Agent-API eines anderen Hosts (z. B. TrueNAS)
SERVERS=Unraid=local;TrueNAS=http://10.10.10.100:8091

# Interfaces, die als "Gesamt-Traffic" zählen (kommagetrennt).
# Auto-Fallback ohne Wert: br0 -> bond0 -> erstes eth*/en*
UPLINK=br0

# Ports
WEB_PORT=8090
AGENT_PORT=8091

# Optional: gemeinsames Token zwischen web und agent
# (Web sendet es als Header X-Agent-Token an den TrueNAS-Agenten)
AGENT_TOKEN=

# Optional: vorgebautes Image statt lokalem Build.
# Beispiel: NETSPY_IMAGE=ghcr.io/thefirstmojo/netspy:latest
# (entsteht per Tag-Push, siehe .github/workflows/publish-image.yml)
# Repo + GHCR-Package sind public -> Pull ohne Login.
# (Falls das Package je wieder privat wird: einmalig
#  docker login ghcr.io -u thefirstmojo bzw. GHCR-Registry in Portainer.)
# Start ohne Build:  docker compose up -d --no-build   (bzw. docker compose pull)
NETSPY_IMAGE=

# Optional: Container-Name
NETSPY_CONTAINER=netspy
